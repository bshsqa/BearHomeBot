{
  "schemaVersion": 1,
  "upstream": {
    "url": "https://github.com/NomaDamas/k-skill.git",
    "branch": "main"
  },
  "limits": {
    "maxFiles": 5000,
    "maxBlobBytes": 5242880,
    "maxTotalBytes": 52428800,
    "maxPathBytes": 4096,
    "maxSegmentBytes": 255
  },
  "behaviorReview": {
    "policyVersion": 1,
    "timeoutSeconds": 600,
    "batchSize": 8,
    "maxConcurrency": 3
  },
  "release": {
    "minimumRetained": 3
  }
}
