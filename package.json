{
  "name": "bearhomebot",
  "version": "0.0.0",
  "private": true,
  "description": "Ubuntu control plane for Telegram, Codex CLI, and reviewed k-skill releases",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "ci": "npm run lint && npm test && npm run build && npm run format:check && bash -n scripts/*.sh",
    "dev": "tsc --watch -p tsconfig.build.json",
    "doctor": "bash scripts/doctor.sh",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" package.json \"tsconfig*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" package.json \"tsconfig*.json\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "tsc -p tsconfig.test.json && node --test .runtime/test-dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  }
}
